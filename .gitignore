# Bytecode de Python
__pycache__/
*.py[cod]

# Salidas de PyInstaller (Generar_App_Instalable.bat / Generar_App_Admin.bat)
build/
dist/
dist_rapida/
compilar/salida/
*.spec
TechClean.exe
TechClean_ES.exe
TechClean_EN.exe
TechClean_Admin.exe
# copias de seguridad que deja el generador si el .exe anterior estaba abierto
TechClean_*_anterior.exe
TechClean_*_viejo_en_uso.exe

# Marca que dejan Iniciar.bat / Iniciar_Admin.bat tras instalar dependencias
.deps_ok

# Entornos virtuales
.venv/
venv/

# Nota: preferencias.json y el registro de errores viven en
# %APPDATA%\TechClean, fuera de esta carpeta — no hace falta ignorarlos.
